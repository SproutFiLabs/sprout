# Sprout backend / chain configuration. The server reads process.env directly.
# Missing live values are reported rather than replaced with guessed addresses.

# Chain: 31337 local Anvil, 4663 Robinhood Chain, 46630 Robinhood testnet.
SPROUT_CHAIN_ID=31337
# Internal RPC (may contain credentials; never returned by /api/config).
SPROUT_RPC_URL=http://127.0.0.1:18545
# Optional RPC safe to hand to a browser wallet (e.g. loopback or a public endpoint).
SPROUT_PUBLIC_WALLET_RPC_URL=
# Token contract address shown with a Copy button on the landing page and
# dashboard (0x… or base58). Leave empty to hide it.
SPROUT_PUBLIC_CA=
# SPROUT holder perks (/perks). Off until the token is set; server/src/holders.ts.
# SPROUT_HOLDER_TOKEN=0x...                      # the SPROUT token contract
# SPROUT_HOLDER_TIERS=seedling:100000,sapling:1000000,bloom:5000000,grove:10000000
# SPROUT_HOLDER_HOLD_DAYS=7                      # 24 hours while SPROUT is younger than this
# SPROUT_EARLY_ACCESS_SYMBOLS=COIN,ORCL          # first dibs: locked below the tier until...
# SPROUT_EARLY_ACCESS_UNTIL=2026-10-01T00:00:00Z
# SPROUT_EARLY_ACCESS_TIER=sapling
# SPROUT_AUTOINVEST_TIER=bloom                   # keeper only runs plans of parents at this tier

SPROUT_FACTORY_ADDRESS=
SPROUT_SETTLEMENT_TOKEN=
SPROUT_SETTLEMENT_DECIMALS=6
# Ticker shown for the settlement token, e.g. USDG. Falls back to "Settlement".
SPROUT_SETTLEMENT_SYMBOL=
# Canonical public origin for absolute URLs in gift-link previews (default https://www.sproutfy.tech).
SPROUT_PUBLIC_ORIGIN=
# Seconds between growth snapshots of every sprout (default 300).
SPROUT_SNAPSHOT_INTERVAL_SECONDS=
SPROUT_VENUE_ADDRESS=
# symbol:address:decimals:multiplier:feedAddress[:heartbeatSeconds], comma separated.
# Every stock any configured factory admits; a sprout holds only a subset.
# multiplier and uiMultiplier are 1e18-scaled and used only for share-equivalent display.
SPROUT_STOCK_TOKENS=
# Optional display names, SYM:Name comma separated (e.g. AAPL:Apple,SPY:S&P 500).
SPROUT_STOCK_NAMES=
# Earlier factories whose sprouts are still served, each with the only venue its
# sprouts can use: factory:venue:startBlock, comma separated. Empty for local dev.
# See docs/DEPLOY-RAILWAY.md for the production value.
SPROUT_LEGACY_DEPLOYMENTS=

# A configured keeper key is a server-only secret and is allowed on a live chain.
# Well-known Anvil development keys are refused unless the RPC is loopback on 31337.
SPROUT_KEEPER_PRIVATE_KEY=

# Keeper automation is enabled only when the key AND all three caps below are set.
# Transactions above a cap are rejected (no clamping) and daily spend counts
# actual + pending reservations across restarts.
SPROUT_KEEPER_MAX_FEE_PER_GAS_WEI=
SPROUT_KEEPER_MAX_PRIORITY_FEE_PER_GAS_WEI=
SPROUT_KEEPER_GAS_LIMIT_CAP=
SPROUT_KEEPER_DAILY_FEE_BUDGET_WEI=

# Local demo (fixtures + dev accounts + Anvil only). Never enable on a live chain.
SPROUT_LOCAL_DEMO=0
SPROUT_USE_LOCAL_KEYS=0

# Storage and HTTP
SPROUT_DATA_DIR=./data
SPROUT_DB_PATH=./data/sprout.sqlite
SPROUT_PORT=4317
SPROUT_BIND=127.0.0.1
SPROUT_SERVE_WEB=0
SPROUT_WEB_DIST=./web/dist
SPROUT_ADMIN_TOKEN=

# Public-chain indexing (mainnet beta)
SPROUT_START_BLOCK=0
SPROUT_MAX_LOG_RANGE=2000


# SPROUT Intelligence — independent community-token network (not the vault chain).
# User-confirmed Robinhood mainnet; defaults are also provided in the server.
SPROUT_INTELLIGENCE_CHAIN_ID=4663
SPROUT_INTELLIGENCE_CHAIN_NAME=Robinhood Chain
SPROUT_INTELLIGENCE_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Server-only. Never use a VITE_ prefix or expose this in /api/config.
OPENAI_API_KEY=
SPROUT_INTELLIGENCE_MODEL=gpt-4.1-mini
# Enforced request caps; these are NOT a provider dollar spending cap.
SPROUT_INTELLIGENCE_DAILY_LIMIT=40
SPROUT_INTELLIGENCE_GLOBAL_DAILY_LIMIT=500

# Sprout Spend: server-only Bitrefill credentials, never browser/VITE variables.
# Checkout remains unavailable until credentials and vetted US/USD product IDs exist.
SPROUT_SPEND_ENABLED=false
# Personal account key (Bearer); takes precedence when set.
BITREFILL_API_KEY=
# Alternatively, Business API credentials (Basic).
BITREFILL_API_ID=
BITREFILL_API_SECRET=
SPROUT_SPEND_PRODUCT_IDS=
